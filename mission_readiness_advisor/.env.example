# ══════════════════════════════════════════════════════════════════════════════
#  Mission Readiness Advisor — Environment Variables
#  Copy this file to .env and fill in your credentials:
#    Windows:  copy .env.example .env
#    Mac/Linux: cp .env.example .env
#
#  The app works WITHOUT any keys (uses DEMO_KEY + static datasets + template
#  advisory). Add keys one by one — each upgrade makes it more accurate.
# ══════════════════════════════════════════════════════════════════════════════


# ── 1. NASA DONKI API  ────────────────────────────────────────────────────────
#  Enables live space-weather data (solar flares, CME, geomagnetic storms).
#  Without it: system uses local CSV datasets (2023-2025) — still works.
#
#  Sign-up  : https://api.nasa.gov/
#    1. Click "Generate API Key"
#    2. Fill in name + email → key is emailed instantly (also shown on page)
#    3. Free tier: 1,000 requests/day  (no credit card needed)
#
#  DEMO_KEY works right now but is rate-limited to 30 req/hr shared globally.
#  Get your own key for reliable performance during judging.
NASA_API_KEY=DEMO_KEY


# ── 2. OpenWeatherMap API  ────────────────────────────────────────────────────
#  Enables live surface weather at the selected launch site.
#  Without it: user must enter weather manually via the sidebar sliders.
#
#  Sign-up  : https://openweathermap.org/api
#    1. Click "Sign In" → "Create an Account" (free, no credit card)
#    2. Go to https://home.openweathermap.org/api_keys
#    3. Copy the default key (or click "Generate" for a named key)
#    4. Wait up to 10 minutes for the key to activate
#
#  Free tier: 1,000 calls/day, "Current weather" + "5 day forecast" included.
OWM_API_KEY=


# ── 3. IBM watsonx.ai  (Granite LLM Advisory)  ────────────────────────────────
#  Enables the AI-generated mission briefing using IBM Granite 13B.
#  Without it: app falls back to a rule-based template (still readable).
#
#  Sign-up  : https://cloud.ibm.com/registration?utm_content=academicsb
#    1. Create a free IBM Cloud account (no credit card for Lite plan)
#    2. Go to https://dataplatform.cloud.ibm.com/
#    3. Click "New project" → "Create an empty project" → note the PROJECT ID
#       (shown in Project Settings → General → Project ID)
#    4. Go to https://cloud.ibm.com/iam/apikeys
#       Click "Create an IBM Cloud API key" → copy the key immediately
#       (shown only once)
#    5. Check your region URL below:
#       Dallas (us-south) : https://us-south.ml.cloud.ibm.com  ← default
#       London (eu-gb)    : https://eu-gb.ml.cloud.ibm.com
#       Frankfurt (eu-de) : https://eu-de.ml.cloud.ibm.com
#       Tokyo (jp-tok)    : https://jp-tok.ml.cloud.ibm.com
#
#  Also install the SDK (not in requirements.txt to keep the app optional):
#    pip install ibm-watsonx-ai>=1.0.4
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
